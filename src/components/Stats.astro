---
import { photos } from '../data/photos';
---

<section class="stats" aria-label="About the photos">
  <div class="container grid">
    <div>
      <p class="figure">{photos.length}</p>
      <p>photos in the passport</p>
    </div>
    <div>
      <p class="figure">100%</p>
      <p>taken on location, by a human, with a camera</p>
    </div>
    <div>
      <p class="figure">0</p>
      <p>photoshopped or AI-generated stamps (except “<a href="#daydreams">Daydreams</a>”)</p>
    </div>
  </div>
</section>

<style>
  .stats {
    border-block: 2px dashed #C9BFA6;
    background: rgba(251, 248, 240, 0.7);
  }

  .grid {
    padding-block: 14px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px 32px;
    align-items: center;
  }

  .grid > div {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .figure {
    flex: none;
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-navy);
  }

  .figure + p {
    font-size: 15px;
    line-height: 1.3;
  }

</style>
