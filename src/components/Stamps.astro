---
import Stamp from './Stamp.astro';
import { photos } from '../data/photos';

// Stamps shown up front; the rest are revealed in batches of this size as the well scrolls.
const BATCH = 16;
---

<section id="stamps" class="container">
  <div class="heading">
    <div>
      <p class="eyebrow">Entries &amp; exits</p>
      <h2>The stamps</h2>
    </div>
    <p class="hint">{photos.length} stamps · scroll to keep flipping</p>
  </div>

  <div class="well" data-stamp-well tabindex="0" role="region" aria-label="Passport stamps, scrollable">
    <ol class="grid">
      {photos.map((photo, index) => <Stamp photo={photo} index={index} pending={index >= BATCH} />)}
    </ol>
    <div class="status" data-stamp-sentinel role="status">
      <span class="loading">
        <svg class="spin" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9"></path></svg>
        Flipping to the next page…
      </span>
      <span class="done">Last page · more stamps pending his next trip</span>
    </div>
  </div>
</section>

<script>
  const BATCH = 16;
  const well = document.querySelector<HTMLElement>('[data-stamp-well]');
  const sentinel = well?.querySelector<HTMLElement>('[data-stamp-sentinel]');

  if (well && sentinel) {
    const complete = () => {
      well.dataset.complete = 'true';
      observer.disconnect();
    };

    const revealNext = () => {
      const pending = well.querySelectorAll('.visa.pending');
      Array.from(pending)
        .slice(0, BATCH)
        .forEach((el) => el.classList.remove('pending'));
      if (pending.length <= BATCH) complete();
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        revealNext();
        if (well.dataset.complete) return;
        // Re-observe so a sentinel that is still in view after this batch triggers the next one.
        observer.unobserve(sentinel);
        requestAnimationFrame(() => observer.observe(sentinel));
      },
      { root: well, rootMargin: '0px 0px 600px 0px' }
    );

    if (well.querySelector('.visa.pending')) observer.observe(sentinel);
    else complete();

    // Size the well to show exactly three rows of stamps (phones keep the CSS height).
    const ROWS = 3;
    const fitRows = () => {
      if (window.innerWidth <= 640) {
        well.style.removeProperty('height');
        return;
      }
      const tops = Array.from(well.querySelectorAll<HTMLElement>('.visa:not(.pending)'), (el) => el.offsetTop);
      const rowTops = [...new Set(tops)].sort((a, b) => a - b);
      if (rowTops.length <= ROWS) return;
      const style = getComputedStyle(well);
      const rowGap = parseFloat(getComputedStyle(well.querySelector('.grid')!).rowGap) || 0;
      const height =
        rowTops[ROWS] - rowGap + parseFloat(style.paddingBottom) + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth);
      well.style.height = `${Math.ceil(height)}px`;
    };

    document.fonts?.ready.then(fitRows);
    new ResizeObserver(fitRows).observe(well);
  }
</script>

<style>
  #stamps {
    padding-block: 28px 48px;
    scroll-margin-top: 16px;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px 24px;
    margin-bottom: 16px;
  }

  .eyebrow {
    margin-bottom: 6px;
    color: var(--ink-red);
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.05;
    color: var(--color-navy);
  }

  .hint {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .well {
    /* Script sizes this to show exactly three rows; this is the fallback. */
    height: 860px;
    overflow-y: auto;
    position: relative;
    overscroll-behavior: contain;
    background: var(--color-paper-well);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    box-shadow: inset 0 2px 10px rgba(28, 37, 65, 0.12);
    padding: 24px 24px 16px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-navy) transparent;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 22px 20px;
  }

  .status {
    display: flex;
    justify-content: center;
    padding: 32px 0 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .loading {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .loading svg {
    color: var(--ink-red);
  }

  .done,
  :global(html:not(.js)) .loading,
  .well[data-complete] .loading {
    display: none;
  }

  :global(html:not(.js)) .done,
  .well[data-complete] .done {
    display: inline;
  }

  .spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 640px) {
    #stamps {
      padding-block: 32px 40px;
    }

    h2 {
      font-size: 34px;
    }

    .well {
      padding: 16px 12px 12px;
      height: 80vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spin {
      animation: none;
    }
  }
</style>
