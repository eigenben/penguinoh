---
import { photos } from '../data/photos';

const slides = photos.map((photo) => ({
  src: photo.image.src,
  caption: [photo.place, photo.detail].filter(Boolean).join(' · '),
  alt: photo.place ? `Penguinoh at ${[photo.place, photo.detail].filter(Boolean).join(', ')}` : 'Penguinoh on his travels',
  entry: photo.entry,
}));
---

<dialog id="lightbox">
  <div class="lightbox-backdrop">
    <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
    <button class="lightbox-prev" type="button" aria-label="Previous">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <button class="lightbox-next" type="button" aria-label="Next">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
  </div>
</dialog>

<script define:vars={{ slides }}>
  const dialog = document.getElementById('lightbox');
  const img = document.getElementById('lightbox-img');
  const caption = document.getElementById('lightbox-caption');
  const buttons = document.querySelectorAll('.gallery-button');
  let currentIndex = 0;

  function show(index) {
    const slide = slides[index];
    currentIndex = index;
    img.src = slide.src;
    img.alt = slide.alt;
    caption.textContent = slide.caption ? `Entry ${slide.entry} · ${slide.caption}` : `Entry ${slide.entry}`;
  }

  function open(index) {
    show(index);
    dialog.showModal();
  }

  function close() {
    dialog.close();
  }

  function navigate(direction) {
    show((currentIndex + direction + slides.length) % slides.length);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const index = parseInt(btn.dataset.index, 10);
      open(index);
    });
  });

  dialog.querySelector('.lightbox-close').addEventListener('click', close);
  dialog.querySelector('.lightbox-prev').addEventListener('click', () => navigate(-1));
  dialog.querySelector('.lightbox-next').addEventListener('click', () => navigate(1));

  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target.classList.contains('lightbox-backdrop') || e.target.classList.contains('lightbox-figure')) {
      close();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') navigate(-1);
    if (e.key === 'ArrowRight') navigate(1);
  });

  // Touch swipe support
  let touchStartX = 0;
  dialog.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  });
  dialog.addEventListener('touchend', (e) => {
    const diff = e.changedTouches[0].screenX - touchStartX;
    if (Math.abs(diff) > 50) {
      navigate(diff > 0 ? -1 : 1);
    }
  });
</script>

<style>
  /* Freeze the page behind the open lightbox; the gutter keeps the layout from shifting. */
  :global(html:has(#lightbox[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  dialog {
    padding: 0;
    border: none;
    background: none;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    overscroll-behavior: contain;
  }

  dialog::backdrop {
    background: rgba(20, 27, 49, 0.94);
  }

  .lightbox-backdrop {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  #lightbox-img {
    max-width: 88vw;
    max-height: 82dvh;
    object-fit: contain;
    border-radius: 4px;
    border: 10px solid var(--color-paper-light);
  }

  #lightbox-caption {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-paper);
    text-align: center;
    padding-inline: 16px;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(243, 238, 226, 0.35);
    background: rgba(20, 27, 49, 0.72);
    color: var(--color-paper-light);
    cursor: pointer;
    box-shadow: 0 6px 18px -8px rgba(0, 0, 0, 0.6);
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: var(--color-navy-raised);
    border-color: rgba(243, 238, 226, 0.7);
  }

  .lightbox-close:focus-visible,
  .lightbox-prev:focus-visible,
  .lightbox-next:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-prev:active,
  .lightbox-next:active {
    transform: translateY(-50%) scale(0.94);
  }

  .lightbox-prev {
    left: 1rem;
  }

  .lightbox-next {
    right: 1rem;
  }

  /* On phones the photo spans the screen, so the arrows move below it instead of sitting on top. */
  @media (max-width: 640px) {
    .lightbox-figure {
      margin-bottom: 72px;
    }

    #lightbox-img {
      max-width: calc(100vw - 32px);
      max-height: calc(100dvh - 200px);
      border-width: 6px;
    }

    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: max(1.25rem, env(safe-area-inset-bottom));
      transform: none;
      width: 56px;
      height: 56px;
    }

    .lightbox-prev:active,
    .lightbox-next:active {
      transform: scale(0.94);
    }

    .lightbox-prev {
      left: calc(50% - 68px);
    }

    .lightbox-next {
      right: calc(50% - 68px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
      transition: none;
    }
  }
</style>
